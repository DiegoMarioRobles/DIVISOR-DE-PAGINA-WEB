# Copiar este archivo a ".env" y completar los valores reales.
# ".env" nunca se versiona (ver .gitignore).

# Puerto donde escucha el servidor Express. Railway inyecta su propia
# variable PORT en producción; en desarrollo local se usa este valor.
PORT=3000

# Entorno de ejecución (development | production). Informativo, no
# cambia el comportamiento del servidor pero es útil para logs.
NODE_ENV=development

# Secreto usado para firmar y verificar los tokens JWT del panel de
# administración. OBLIGATORIO cambiarlo por un valor largo y aleatorio
# en producción (por ejemplo: openssl rand -hex 64). Si no se define,
# el servidor arranca igual con un valor de desarrollo inseguro, pero
# nunca debe dejarse así en producción.
JWT_SECRET=cambiar-este-valor-por-un-secreto-largo-y-aleatorio

# Ruta del archivo de base de datos SQLite. Opcional: si no se define,
# se usa "data.db" en la raíz del proyecto.
DB_PATH=./data.db

# URL pública del sitio (sin "/" al final), usada para armar los links
# de confirmación y baja de suscripción dentro de los mails. En Railway,
# poné la URL que te asigna (o tu dominio propio si ya lo conectaste).
SITE_URL=http://localhost:3000

# API key de tu cuenta en https://resend.com, para mandar los mails de
# confirmación de suscripción y el resumen de noticias nuevas. Sin esto,
# el sitio funciona igual: simplemente no se envía ningún mail (queda
# un aviso en los logs del servidor).
RESEND_API_KEY=

# Remitente de los mails, con el formato "Nombre <direccion@dominio>".
# Sin un dominio propio verificado en Resend, solo podés mandar mail al
# mismo casillero con el que te registraste en Resend (limitación de su
# modo de prueba/sandbox). Para mandar a cualquier suscriptor real hace
# falta verificar un dominio propio en el panel de Resend.
RESEND_FROM=El Observador <noticias@tudominio.com>
